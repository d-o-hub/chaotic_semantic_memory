#!/usr/bin/env bash
# Pre-commit hook: runs quality gates before allowing commits.
# Configure with: git config core.hooksPath .githooks

set -uo pipefail

# Ensure cargo/rustfmt are available
if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT" || exit 1

# If pre-commit is installed, use it
if command -v pre-commit >/dev/null 2>&1; then
  exec pre-commit run --all-files
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAILED=0

printf "${YELLOW}Running pre-commit quality checks (fallback)...${NC}\n\n"

# Only check staged .rs files
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs' 2>/dev/null)
STAGED_TOML=$(git diff --cached --name-only --diff-filter=ACM -- '*.toml' 2>/dev/null)
STAGED_YAML=$(git diff --cached --name-only --diff-filter=ACM -- '*.yml' '*.yaml' 2>/dev/null)

if [[ -z "$STAGED_RS" && -z "$STAGED_TOML" && -z "$STAGED_YAML" ]]; then
  printf "${GREEN}No staged .rs, .toml, or .yaml files — skipping checks.${NC}\n"
  exit 0
fi

# LOC limit check on staged .rs files (max 500 lines)
MAX_LINES=500
if [[ -n "$STAGED_RS" ]]; then
  printf "Checking line counts (max %d)...\n" "$MAX_LINES"
  for f in $STAGED_RS; do
    if [[ -f "$f" ]]; then
      lines=$(wc -l < "$f" 2>/dev/null || echo 0)
      if [[ "$lines" -gt "$MAX_LINES" ]]; then
        printf "  ${RED}✗ %s: %d lines (max %d)${NC}\n" "$f" "$lines" "$MAX_LINES"
        FAILED=1
      else
        printf "  ${GREEN}✓ %s OK (%d lines)${NC}\n" "$f" "$lines"
      fi
    fi
  done
fi

# Format check on staged files
if [[ -n "$STAGED_RS" ]]; then
  printf "Checking formatting...\n"
  if ! echo "$STAGED_RS" | xargs rustfmt --check 2>/dev/null; then
    printf "${RED}  ✗ Formatting issues found. Run: cargo fmt --all${NC}\n"
    FAILED=1
  else
    printf "${GREEN}  ✓ Format OK${NC}\n"
  fi
fi

# Clippy on workspace (can't check staged files only)
if [[ -n "$STAGED_RS" ]]; then
  printf "Running clippy...\n"
  if ! cargo clippy --all-targets --all-features -- -D warnings >/dev/null 2>&1; then
    printf "${RED}  ✗ Clippy warnings found. Run: cargo clippy --all-targets --all-features -- -D warnings${NC}\n"
    FAILED=1
  else
    printf "${GREEN}  ✓ Clippy OK${NC}\n"
  fi
fi

# Secret scan on staged files (if gitleaks is installed)
if command -v gitleaks >/dev/null 2>&1; then
    printf "Scanning for secrets (gitleaks)...\n"
    if ! gitleaks protect --staged --verbose; then
        FAILED=1
    else
        printf "${GREEN}  ✓ Secret scan OK${NC}\n"
    fi
fi

printf "\n"

if [[ $FAILED -ne 0 ]]; then
  printf "${RED}Pre-commit checks FAILED. Fix issues above before committing.${NC}\n"
  printf "To bypass (not recommended): git commit --no-verify\n"
  exit 1
fi

printf "${GREEN}All pre-commit checks passed.${NC}\n"
exit 0
