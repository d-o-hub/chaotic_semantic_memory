# Canonical CI / tool settings (source of truth).
# Workflows: source this file or map keys via env: blocks.
# Do not duplicate bare versions/timeouts in job steps.

# cargo-fuzz (must match a released crates.io version)
CARGO_FUZZ_VERSION=0.12.0

# PR short fuzz runs (seconds). 0 = compile-only (skip short runs).
FUZZ_SHORT_SECONDS=10

# libFuzzer single-input wall timeout (seconds) for short PR runs
FUZZ_INPUT_TIMEOUT_SECONDS=5

# Scheduled full fuzz: seconds per target
FUZZ_SCHEDULED_SECONDS_PER_TARGET=120

# Scheduled job wall clock (minutes)
FUZZ_SCHEDULED_JOB_TIMEOUT_MINUTES=180

# Fuzz workspace compile / PR fuzz job wall clock (minutes)
FUZZ_PR_JOB_TIMEOUT_MINUTES=30

# Smoke targets for PR short runs (space-separated)
FUZZ_PR_SMOKE_TARGETS="hvec_from_bytes reservoir_step fuzz_text_encoder"

# Rustup profile for ephemeral toolchains in CI
RUSTUP_TOOLCHAIN_PROFILE=minimal
